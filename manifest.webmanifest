{
 "name": "KCSI Docs",
 "short_name": "KCSI Docs",
 "description": "변사 사건 · 의뢰증거물 인수인계서 · 현장 사진 · 문서 사진",
 "lang": "ko",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#1f3a5f",
 "theme_color": "#1f3a5f",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-maskable.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "related_applications": [
  {
   "platform": "webapp",
   "url": "https://gj-kcsi.github.io/kcsi/manifest.webmanifest"
  }
 ],
 "id": "/kcsi/",
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "file",
     "accept": [
      "text/plain",
      ".txt"
     ]
    }
   ]
  }
 }
}